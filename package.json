{
  "name": "flamesync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, browser-local thrust curve video studio for GitHub Pages.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8081",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:frames": "node tests/frame-stepping-runner.mjs",
    "test:profiles": "node tests/profile-browser-runner.mjs",
    "test:series": "node tests/series-browser-runner.mjs",
    "test:theory": "node tests/theory-browser-runner.mjs",
    "test:templates": "node tests/templates-browser-runner.mjs",
    "test:preferences": "node tests/preferences-browser-runner.mjs",
    "test:custom-csv": "node tests/custom-csv-browser-runner.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mediabunny": "1.61.5"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
